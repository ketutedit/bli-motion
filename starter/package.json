{
  "name": "bli-motion-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion explainer example starter for BLI Motion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render src/index.ts MainExplainer out/video.mp4",
    "render:rain": "remotion render src/index.ts HowRainForms out/hujan-terbentuk.mp4",
    "render:kids": "remotion render src/index.ts KidsDrinkingGuide out/cara-minum-anak.mp4",
    "render:streamflow": "remotion render src/index.ts StreamFlowPromo out/streamflow-promo.mp4",
    "render:bumil": "remotion render src/index.ts PregnancyTipsReel out/tips-bumil-trimester3.mp4",
    "test:stills": "bash scripts/render-preview.sh",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.4.5"
  }
}